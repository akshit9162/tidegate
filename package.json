{
  "name": "tidegate",
  "version": "0.1.1",
  "description": "Deploy AI agents. A worse version can't go live: every deploy replays real inputs and is blocked if it does worse.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:e2e": "wrangler dev --var UPSTREAM_ANTHROPIC:http://127.0.0.1:8799 --var UPSTREAM_OPENAI:http://127.0.0.1:8799",
    "db": "wrangler d1 execute tidegate --local --file worker/schema.sql",
    "db:remote": "wrangler d1 execute tidegate --remote --file worker/schema.sql",
    "test": "node --test test/*.test.mjs"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "wrangler": "^4.166.0"
  },
  "bin": {
    "tidegate": "cli/tidegate.mjs",
    "git-remote-tidegate": "cli/git-remote-tidegate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "cli/",
    "worker/",
    "wrangler.toml",
    "examples/",
    "README.md",
    "LICENSE",
    "!**/__pycache__"
  ],
  "keywords": [
    "ai-agents",
    "deploy",
    "evals",
    "llm",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshit9162/tidegate.git"
  },
  "homepage": "https://github.com/akshit9162/tidegate#readme",
  "bugs": {
    "url": "https://github.com/akshit9162/tidegate/issues"
  }
}
